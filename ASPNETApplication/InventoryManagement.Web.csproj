  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Database\SQLScripts\SeedData.sql" LogicalName="InventoryManagement.Web.SeedData.sql" Link="Data\SeedData.sql" />
  </ItemGroup>

