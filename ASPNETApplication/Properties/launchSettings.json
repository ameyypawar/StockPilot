      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ConnectionStrings__DefaultConnection": "Server=localhost,1433;Database=InventoryManagementDB;User Id=sa;Password=Inventory@2026Dev;TrustServerCertificate=True;Encrypt=False"
      }
    },
    "LAN": {
      "commandName": "Project",
      "dotnetRunMessages": true,
