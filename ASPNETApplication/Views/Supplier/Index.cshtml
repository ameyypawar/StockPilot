@model List<InventoryManagement.Web.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<h2>Supplier Management</h2>

<p><a asp-action="Create" class="btn btn-primary">+ Add New Supplier</a></p>

<form method="get" asp-action="Index" class="filter-bar">
    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by name, contact, email or address..." />
    <button type="submit" class="btn btn-secondary">Search</button>
</form>

<div class="table-wrap">
<table>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Contact Number</th>
        <th>Email</th>
        <th>Address</th>
        <th>Products</th>
        <th>Actions</th>
    </tr>
    @foreach (var supplier in Model)
    {
        <tr>
            <td>@supplier.SupplierId</td>
            <td>@supplier.SupplierName</td>
            <td>@supplier.ContactNumber</td>
            <td>@supplier.Email</td>
            <td>@supplier.Address</td>
            <td>@supplier.Products.Count</td>
            <td>
                <a asp-action="Edit" asp-route-id="@supplier.SupplierId">Edit</a>
                <a asp-action="Delete" asp-route-id="@supplier.SupplierId">Delete</a>
            </td>
        </tr>
    }
</table>
</div>
