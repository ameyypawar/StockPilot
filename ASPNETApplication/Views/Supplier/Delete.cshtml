@model InventoryManagement.Web.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<h2>Delete Supplier</h2>

<p>Are you sure you want to delete this supplier?</p>

<p><strong>@Model.SupplierName</strong> — @Model.ContactNumber</p>

@if (ViewBag.ProductCount > 0)
{
    <div class="alert alert-warning">
        This supplier is used by @ViewBag.ProductCount product(s). Reassign or delete those products before deleting this supplier.
    </div>
}
else
{
    <form method="post" asp-action="Delete">
        <input type="hidden" name="id" value="@Model.SupplierId" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
    </form>
}

<p><a asp-action="Index">Cancel</a></p>
