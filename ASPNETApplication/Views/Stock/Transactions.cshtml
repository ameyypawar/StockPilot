@model List<InventoryManagement.Web.Models.StockTransaction>

@{
    ViewData["Title"] = "Transaction History";
}

<h2>Transaction History</h2>

<form method="get" asp-action="Transactions" class="filter-bar">
    <select name="type" class="form-select">
        <option value="">All Types</option>
        <option value="StockIn" selected="@(ViewBag.SelectedType == "StockIn")">Stock In</option>
        <option value="StockOut" selected="@(ViewBag.SelectedType == "StockOut")">Stock Out</option>
    </select>
    <button type="submit" class="btn btn-secondary">Filter</button>
</form>

<div class="table-wrap">
<table>
    <tr>
        <th>Date</th>
        <th>Product</th>
        <th>Type</th>
        <th>Quantity</th>
        <th>Performed By</th>
        <th>Remarks</th>
    </tr>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.TransactionDate.ToString("g")</td>
            <td>@t.Product?.ProductName</td>
            <td>@t.Type</td>
            <td>@t.Quantity</td>
            <td>@t.PerformedBy</td>
            <td>@t.Remarks</td>
        </tr>
    }
</table>
</div>

<p><a asp-action="Index">Back to Stock Overview</a></p>
