@model InventoryManagement.Web.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<h2>Edit Product</h2>

<form method="post" asp-action="Edit">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="ProductId" />
    <div class="mb-3">
        <label class="form-label">Product Name</label>
        <input type="text" asp-for="ProductName" class="form-control" required />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Price</label>
        <input type="number" step="0.01" asp-for="Price" class="form-control" required />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Unit</label>
        <input type="text" asp-for="Unit" class="form-control" list="unitOptions" required />
        <datalist id="unitOptions">
            <option value="pcs" />
            <option value="kg" />
            <option value="g" />
            <option value="L" />
            <option value="ml" />
            <option value="pack" />
            <option value="box" />
            <option value="bottle" />
            <option value="bag" />
        </datalist>
    </div>
    <div class="mb-3">
        <label class="form-label">Category</label>
        <select name="CategoryId" class="form-select">
            @foreach (var cat in (List<InventoryManagement.Web.Models.Category>)ViewBag.Categories)
            {
                if (cat.CategoryId == Model.CategoryId)
                {
                    <option value="@cat.CategoryId" selected>@cat.CategoryName</option>
                }
                else
                {
                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                }
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Supplier</label>
        <select name="SupplierId" class="form-select">
            @foreach (var sup in (List<InventoryManagement.Web.Models.Supplier>)ViewBag.Suppliers)
            {
                if (sup.SupplierId == Model.SupplierId)
                {
                    <option value="@sup.SupplierId" selected>@sup.SupplierName</option>
                }
                else
                {
                    <option value="@sup.SupplierId">@sup.SupplierName</option>
                }
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

<a asp-action="Index">Back to List</a>
