@model List<InventoryManagement.Web.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h2>Product Management</h2>

<p><a asp-action="Create" class="btn btn-primary">+ Add New Product</a></p>

<form method="get" asp-action="Index" class="filter-bar">
    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by name, category or supplier..." />
    <select name="categoryId" class="form-select">
        <option value="">All Categories</option>
        @foreach (var cat in (List<InventoryManagement.Web.Models.Category>)ViewBag.Categories)
        {
            if (ViewBag.CategoryId != null && (int)ViewBag.CategoryId == cat.CategoryId)
            {
                <option value="@cat.CategoryId" selected>@cat.CategoryName</option>
            }
            else
            {
                <option value="@cat.CategoryId">@cat.CategoryName</option>
            }
        }
    </select>
    <button type="submit" class="btn btn-secondary">Search</button>
</form>

<div class="table-wrap">
<table>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Price</th>
        <th>Unit</th>
        <th>Category</th>
        <th>Supplier</th>
        <th>Stock</th>
        <th>Status</th>
        <th>Actions</th>
    </tr>
    @foreach (var product in Model)
    {
        var qty = product.Stock?.QuantityAvailable ?? 0;
        var reorder = product.Stock?.ReorderLevel ?? 0;
        var status = InventoryManagement.Web.Models.StockStatus.For(qty, reorder);
        <tr>
            <td>@product.ProductId</td>
            <td>@product.ProductName</td>
            <td>Rs. @product.Price.ToString("F2")</td>
            <td>@product.Unit</td>
            <td>@product.Category?.CategoryName</td>
            <td>@product.Supplier?.SupplierName</td>
            <td>@qty</td>
            <td><span class="badge @InventoryManagement.Web.Models.StockStatus.BadgeCss(status)">@status</span></td>
            <td>
                <a asp-action="Edit" asp-route-id="@product.ProductId">Edit</a> |
                <a asp-action="Delete" asp-route-id="@product.ProductId">Delete</a>
            </td>
        </tr>
    }
</table>
</div>
