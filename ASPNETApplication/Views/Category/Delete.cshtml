@model InventoryManagement.Web.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<h2>Delete Category</h2>

<p>Are you sure you want to delete this category?</p>

<p><strong>@Model.CategoryName</strong></p>

@if (ViewBag.ProductCount > 0)
{
    <div class="alert alert-warning">
        This category is used by @ViewBag.ProductCount product(s). Reassign or delete those products before deleting this category.
    </div>
}
else
{
    <form method="post" asp-action="Delete">
        <input type="hidden" name="id" value="@Model.CategoryId" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
    </form>
}

<p><a asp-action="Index">Cancel</a></p>
