@model List<InventoryManagement.Web.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h2>Category Management</h2>

<p><a asp-action="Create" class="btn btn-primary">+ Add New Category</a></p>

<form method="get" asp-action="Index" class="filter-bar">
    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by name..." />
    <button type="submit" class="btn btn-secondary">Search</button>
</form>

<div class="table-wrap">
<table>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Description</th>
        <th>Products</th>
        <th>Actions</th>
    </tr>
    @foreach (var category in Model)
    {
        <tr>
            <td>@category.CategoryId</td>
            <td>@category.CategoryName</td>
            <td>@category.Description</td>
            <td>@category.Products.Count</td>
            <td>
                <a asp-action="Edit" asp-route-id="@category.CategoryId">Edit</a> |
                <a asp-action="Delete" asp-route-id="@category.CategoryId">Delete</a>
            </td>
        </tr>
    }
</table>
</div>
